rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Conteúdo pedagógico publicado é público e somente o backend pode alterá-lo.
    match /content_manifests/{document} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /content_activities/{document} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    // Relatos de problemas podem ser enviados por usuários; leitura e edição restritas ao painel/backend.
    match /reports/{reportId} {
      allow create: if request.resource.data.userId is string;
      allow read, update, delete: if false;
    }
    // A V1 não envia progresso local ao Firebase. Liberar somente após autenticação e revisão LGPD.
    match /users/{userId}/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
